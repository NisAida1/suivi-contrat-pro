<IfModule mod_rewrite.c>
    RewriteEngine On

    # Block direct web access to internal application folders.
    RewriteRule ^(config|database|src|templates)/ - [F,L,NC]

    # Keep direct access for existing files and directories (assets, index.php, etc.).
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Route clean URLs like /login to index.php?page=login.
    RewriteRule ^$ index.php [L,QSA]
    RewriteRule ^([a-zA-Z0-9_-]+)/?$ index.php?page=$1 [L,QSA]
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Deny direct access to potentially sensitive file types.
<FilesMatch "\.(sql|md|log|ini|env)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
