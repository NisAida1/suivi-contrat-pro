# Configuration de la base de données
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=suivi_contrat_pro
DB_USER=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

# URL publique de l'application (sans slash final)
APP_URL=http://localhost:8000

# Nom affiché dans l'application
APP_NAME="Suivi Contrat Pro - PHP"

# Configuration de l'envoi d'emails
# Configuration OVH - Serveur SSL
# Serveur: ssl0.ovh.net, Port: 465 (SSL)

MAIL_DRIVER=smtp

SMTP_HOST=ssl0.ovh.net
SMTP_PORT=465
SMTP_USERNAME=projetsuivicp@eilco-ulco.fr
SMTP_PASSWORD=votre_mot_de_passe
SMTP_ENCRYPTION=ssl

# Adresse d'expédition des emails
MAIL_FROM_ADDRESS=projetsuivicp@eilco-ulco.fr
MAIL_FROM_NAME="Suivi Contrat Pro - EILCO"
