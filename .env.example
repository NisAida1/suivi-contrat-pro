# Configuration de la base de données
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=suivi_contrat_pro
DB_USER=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

# URL publique de l'application (sans slash final)
APP_URL=http://localhost:8000

# Nom affiché dans l'application
APP_NAME="Suivi Contrat Pro - PHP"

# Configuration de l'envoi d'emails
# Pour Gmail, activer l'accès "applications moins sécurisées" ou utiliser un mot de passe d'application
# https://support.google.com/accounts/answer/185833

MAIL_DRIVER=smtp

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=votre.email@example.com
SMTP_PASSWORD=votre_mot_de_passe_app
SMTP_ENCRYPTION=tls

# Adresse d'expédition des emails
MAIL_FROM_ADDRESS=noreply@eilco.fr
MAIL_FROM_NAME="Suivi Contrat Pro - EILCO"
